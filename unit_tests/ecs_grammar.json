    "logic-and-expr": [{"type": "ref", "data": "equal-expr"}, {"type": "opt", "data": [{"type": "cond", "data": [{"data": [{"type": "term", "data": "&&"}]}, {"data": [{"type": "term", "data": "and"}]}]}, {"type": "ref", "data": "logic-and-expr"}]}]
  },
  "lex": {
    "err": "^(\"|'|(\\|)|\\.\\.)$",
