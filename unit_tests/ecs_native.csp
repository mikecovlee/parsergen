# --- Generator ---
class generator
    var errors = null
    var cb = null
    var fp = "<FILE>"

    function from_string(text)
        errors = new array
        cb = text.split({'\n'})
        cb.push_back("")
        foreach l in cb
            for i = 0, i < l.size, ++i
                if l[i] == '\t'
                    l.assign(i, ' ')
                end
            end
        end
        var lx = new parsergen.lexer_type
        var toks = lx.run(_lex, text)
        if !lx.error_log.empty()
            foreach it in lx.error_log
                errors.push_back(it)
            end
            return false
        end
        _cs = 0
        _tk = toks
        return _parse_begin() && _cs == _tk.size
    end
    function get_errors()
        return errors
    end

    function from_file(path)
        var ifs = iostream.ifstream(path)
        if !ifs.good()
            return false
        end
        fp = path
        var full_text = new string
        var lines = new array
        parsergen.read_stream(ifs, lines)
        foreach line in lines
            full_text += line
            full_text += '\n'
        end
        return this.from_string(full_text)
    end
end
