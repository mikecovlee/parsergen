@require: 210503
package json_native

import parsergen, regex

# --- Lex ---
@begin
var _lex = {
    "num" : regex.build("^[0-9]+\\.?([0-9]+)?$"),
    "sig" : regex.build("^(:|,|\\[|\\]|\\{|\\})$"),
    "str" : regex.build("^(\"|\"([^\"]|\\\\\")*\"?)$"),
    "id" : regex.build("^[A-Za-z_]\\w*$"),
    "ign" : regex.build("^\\s+$"),
    "err" : regex.build("^\"$")
}.to_hash_map()
@end

var _cs = 0
var _tk = null

# --- Predict ---
function _p_begin()
    return _cs < _tk.size && (_p_array() || _p_object())
end
function _p_object()
    return _cs < _tk.size && (_tk[_cs].data == "{")
end
function _p_members()
    return _cs < _tk.size && (_p_pair())
end
function _p_pair()
    return _cs < _tk.size && (_tk[_cs].type == "str")
end
function _p_array()
    return _cs < _tk.size && (_tk[_cs].data == "[")
end
function _p_elements()
    return _cs < _tk.size && (_p_value())
end
function _p_value()
    return _cs < _tk.size && (_p_array() || _p_object() || _tk[_cs].data == "false" || _tk[_cs].data == "null" || _tk[_cs].data == "true" || _tk[_cs].type == "num" || _tk[_cs].type == "str")
end
function _p_ignore()
    return _cs < _tk.size && (_tk[_cs].type == "endl")
end

# --- Parse ---

function _parse_begin()
    var _sv = _cs
    var _sv3 = 0
    var _fail = false
    if !_fail
        loop
            if _cs < _tk.size && (_p_object())
                _sv3 = _cs
                _fail = false
                if !_fail
                    if !_p_object() || !_parse_object()
                        _fail = true
                    end
                end
                if !_fail
                    break
                end
                _cs = _sv3
            end
            if _cs < _tk.size && (_p_array())
                _sv3 = _cs
                _fail = false
                if !_fail
                    if !_p_array() || !_parse_array()
                        _fail = true
                    end
                end
                if !_fail
                    break
                end
                _cs = _sv3
            end
            break
        end
    end
    if _fail
        _cs = _sv
        return false
    end
    return true
end

function _parse_object()
    var _sv = _cs
    var _sv3 = 0
    var _fail = false
    if !_fail
        if _cs >= _tk.size || _tk[_cs].data != "{"
            _fail = true
        end
        if !_fail
            _cs++
        end
    end
    if !_fail
        if _cs < _tk.size && (_p_members())
            _sv3 = _cs
            _fail = false
            if !_fail
                if !_p_members() || !_parse_members()
                    _fail = true
                end
            end
            if _fail
                _cs = _sv3
            end
        end
    end
    if !_fail
        if _cs >= _tk.size || _tk[_cs].data != "}"
            _fail = true
        end
        if !_fail
            _cs++
        end
    end
    if _fail
        _cs = _sv
        return false
    end
    return true
end

function _parse_members()
    var _sv = _cs
    var _sv3 = 0
    var _fail = false
    if !_fail
        if !_p_pair() || !_parse_pair()
            _fail = true
        end
    end
    if !_fail
        loop
            if !(_cs < _tk.size && (_tk[_cs].data == ","))
                break
            end
            _sv3 = _cs
            _fail = false
            if !_fail
                if _cs >= _tk.size || _tk[_cs].data != ","
                    _fail = true
                end
                if !_fail
                    _cs++
                end
            end
            if !_fail
                if !_p_pair() || !_parse_pair()
                    _fail = true
                end
            end
            if _fail
                _cs = _sv3
                _fail = false
                break
            end
        end
    end
    if _fail
        _cs = _sv
        return false
    end
    return true
end

function _parse_pair()
    var _sv = _cs
    var _sv3 = 0
    var _fail = false
    if !_fail
        if _cs >= _tk.size || _tk[_cs].type != "str"
            _fail = true
        end
        if !_fail
            _cs++
        end
    end
    if !_fail
        if _cs >= _tk.size || _tk[_cs].data != ":"
            _fail = true
        end
        if !_fail
            _cs++
        end
    end
    if !_fail
        if !_p_value() || !_parse_value()
            _fail = true
        end
    end
    if _fail
        _cs = _sv
        return false
    end
    return true
end

function _parse_array()
    var _sv = _cs
    var _sv3 = 0
    var _fail = false
    if !_fail
        if _cs >= _tk.size || _tk[_cs].data != "["
            _fail = true
        end
        if !_fail
            _cs++
        end
    end
    if !_fail
        if _cs < _tk.size && (_p_elements())
            _sv3 = _cs
            _fail = false
            if !_fail
                if !_p_elements() || !_parse_elements()
                    _fail = true
                end
            end
            if _fail
                _cs = _sv3
            end
        end
    end
    if !_fail
        if _cs >= _tk.size || _tk[_cs].data != "]"
            _fail = true
        end
        if !_fail
            _cs++
        end
    end
    if _fail
        _cs = _sv
        return false
    end
    return true
end

function _parse_elements()
    var _sv = _cs
    var _sv3 = 0
    var _fail = false
    if !_fail
        if !_p_value() || !_parse_value()
            _fail = true
        end
    end
    if !_fail
        loop
            if !(_cs < _tk.size && (_tk[_cs].data == ","))
                break
            end
            _sv3 = _cs
            _fail = false
            if !_fail
                if _cs >= _tk.size || _tk[_cs].data != ","
                    _fail = true
                end
                if !_fail
                    _cs++
                end
            end
            if !_fail
                if !_p_value() || !_parse_value()
                    _fail = true
                end
            end
            if _fail
                _cs = _sv3
                _fail = false
                break
            end
        end
    end
    if _fail
        _cs = _sv
        return false
    end
    return true
end

function _parse_value()
    var _sv = _cs
    var _sv3 = 0
    var _fail = false
    if !_fail
        loop
            if _cs < _tk.size && (_tk[_cs].type == "str")
                _sv3 = _cs
                _fail = false
                if !_fail
                    if _cs >= _tk.size || _tk[_cs].type != "str"
                        _fail = true
                    end
                    if !_fail
                        _cs++
                    end
                end
                if !_fail
                    break
                end
                _cs = _sv3
            end
            if _cs < _tk.size && (_tk[_cs].type == "num")
                _sv3 = _cs
                _fail = false
                if !_fail
                    if _cs >= _tk.size || _tk[_cs].type != "num"
                        _fail = true
                    end
                    if !_fail
                        _cs++
                    end
                end
                if !_fail
                    break
                end
                _cs = _sv3
            end
            if _cs < _tk.size && (_p_object())
                _sv3 = _cs
                _fail = false
                if !_fail
                    if !_p_object() || !_parse_object()
                        _fail = true
                    end
                end
                if !_fail
                    break
                end
                _cs = _sv3
            end
            if _cs < _tk.size && (_p_array())
                _sv3 = _cs
                _fail = false
                if !_fail
                    if !_p_array() || !_parse_array()
                        _fail = true
                    end
                end
                if !_fail
                    break
                end
                _cs = _sv3
            end
            if _cs < _tk.size && (_tk[_cs].data == "true")
                _sv3 = _cs
                _fail = false
                if !_fail
                    if _cs >= _tk.size || _tk[_cs].data != "true"
                        _fail = true
                    end
                    if !_fail
                        _cs++
                    end
                end
                if !_fail
                    break
                end
                _cs = _sv3
            end
            if _cs < _tk.size && (_tk[_cs].data == "false")
                _sv3 = _cs
                _fail = false
                if !_fail
                    if _cs >= _tk.size || _tk[_cs].data != "false"
                        _fail = true
                    end
                    if !_fail
                        _cs++
                    end
                end
                if !_fail
                    break
                end
                _cs = _sv3
            end
            if _cs < _tk.size && (_tk[_cs].data == "null")
                _sv3 = _cs
                _fail = false
                if !_fail
                    if _cs >= _tk.size || _tk[_cs].data != "null"
                        _fail = true
                    end
                    if !_fail
                        _cs++
                    end
                end
                if !_fail
                    break
                end
                _cs = _sv3
            end
            break
        end
    end
    if _fail
        _cs = _sv
        return false
    end
    return true
end

# --- Generator ---
class generator
    var errors = null
    var cb = null
    var fp = "<FILE>"

    function from_string(text)
        errors = new array
        cb = text.split({'\n'})
        cb.push_back("")
        foreach l in cb
            for i = 0, i < l.size, ++i
                if l[i] == '\t'
                    l.assign(i, ' ')
                end
            end
        end
        var lx = new parsergen.lexer_type
        var toks = lx.run(_lex, text)
        if !lx.error_log.empty()
            foreach it in lx.error_log
                errors.push_back(it)
            end
            return false
        end
        _cs = 0
        _tk = toks
        return _parse_begin() && _cs == _tk.size
    end
    function get_errors()
        return errors
    end

    function from_file(path)
        var ifs = iostream.ifstream(path)
        if !ifs.good()
            return false
        end
        fp = path
        var full_text = new string
        var lines = new array
        parsergen.read_stream(ifs, lines)
        foreach line in lines
            full_text += line
            full_text += '\n'
        end
        return this.from_string(full_text)
    end
end
