# parsergen_cxx compatibility wrapper
# Converts variadic CovScript API to CNI array API
import parsergen_cxx as _cxx

package parsergen

var syntax_type = _cxx.syntax_type
var parse_state = _cxx.parse_state

namespace syntax
    function token(data)
        return _cxx.syntax.token(data)
    end
    function term(data)
        return _cxx.syntax.term(data)
    end
    function ref(name)
        return _cxx.syntax.ref(name)
    end
    function nlook(...args)
        return _cxx.syntax.nlook(args)
    end
    function repeat(...args)
        return _cxx.syntax.repeat(args)
    end
    function optional(...args)
        return _cxx.syntax.optional(args)
    end
    function cond_or(...args)
        return _cxx.syntax.cond_or(args)
    end
end

class grammar
    var _impl = new _cxx.grammar
    function ext()
        return _impl.ext()
    end
    function set_ext(v)
        _impl.set_ext(v)
    end
    function lex()
        return _impl.lex()
    end
    function set_lex(v)
        _impl.set_lex(v)
    end
    function stx()
        return _impl.stx()
    end
    function set_stx(v)
        _impl.set_stx(v)
    end
end

class lexer_type
    var _impl = new _cxx.lexer_type
    function run(lex, text)
        return _impl.run(lex, text)
    end
    function error_log()
        return _impl.error_log()
    end
end

class parser_type
    var _impl = new _cxx.parser_type
    function init(stx)
        _impl.init(stx)
    end
    function run(stx, tokens)
        return _impl.run(stx, tokens)
    end
    function production()
        return _impl.production()
    end
    function get_log(n)
        return _impl.get_log(n)
    end
    function log()
        return _impl.log()
    end
    function set_log(v)
        _impl.set_log(v)
    end
end

class recovering_parser_type
    var _impl = new _cxx.recovering_parser_type
    function init(stx)
        _impl.init(stx)
    end
    function parse_with_recovery(tokens)
        return _impl.parse_with_recovery(tokens)
    end
    function get_all_errors()
        return _impl.get_all_errors()
    end
end

class generator
    var _impl = new _cxx.generator
    function add_grammar(lang, gram)
        _impl.add_grammar(lang, gram._impl)
    end
    function from_string(lang, str)
        return _impl.from_string(lang, str)
    end
    function from_file(path)
        return _impl.from_file(path)
    end
    function ast()
        return _impl.ast()
    end
    function get_errors()
        return _impl.get_errors()
    end
    function stop_on_error()
        return _impl.stop_on_error()
    end
    function set_stop_on_error(v)
        _impl.set_stop_on_error(v)
    end
    function show_prompt()
        return _impl.show_prompt()
    end
    function set_show_prompt(v)
        _impl.set_show_prompt(v)
    end
    function enable_log()
        return _impl.enable_log()
    end
    function set_enable_log(v)
        _impl.set_enable_log(v)
    end
    function file_path()
        return _impl.file_path()
    end
    function code_buff()
        return _impl.code_buff()
    end
end

function print_error(file, code, err)
    _cxx.print_error(file, code, err)
end

function print_ast(tree)
    _cxx.print_ast(tree)
end
