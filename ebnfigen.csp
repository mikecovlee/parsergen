package ebnfigen

import parsergen

class ebnf_generator
    var target = system.out
    var syntax = null
    var indent_level = 0
    var indent_width = 4
    function print_indent()
        foreach i in range(indent_level * indent_width) do target.print(' ')
    end
    function print(text)
        target.print(text)
    end
    function println(text)
        target.println(text)
    end
    function sanitize_name(name)
        var result = new string
        for i = 0, i < name.size, ++i
            if name[i] == '-'
                result += '_'
            else
                result += name[i]
            end
        end
        return move(result)
    end
    function escape_str(str)
        var result = new string
        for i = 0, i < str.size, ++i
            if str[i] == '"'
                result += "\\\""
            else
                result += str[i]
            end
        end
        return move(result)
    end
    function gen_sequence(seq)
        var first = true
        foreach it in seq
            if !first
                print(" ")
            end
            first = false
            this.gen_syntax(it)
        end
    end
    function gen_syntax(s)
        switch s.type
            case parsergen.syntax_type.token
                print("<" + s.data + ">")
            end
            case parsergen.syntax_type.term
                print("\"" + escape_str(s.data) + "\"")
            end
            case parsergen.syntax_type.ref
                print(sanitize_name(s.data))
            end
            case parsergen.syntax_type.nlook
                print("!(")
                gen_sequence(s.data)
                print(")")
            end
            case parsergen.syntax_type.repeat
                print("{ ")
                gen_sequence(s.data)
                print(" }")
            end
            case parsergen.syntax_type.opt
                print("[ ")
                gen_sequence(s.data)
                print(" ]")
            end
            case parsergen.syntax_type.cond
                print("(")
                var first = true
                foreach seq in s.data
                    if first
                        first = false
                    else
                        print(" |")
                    end
                    print("\n")
                    ++indent_level
                    print_indent()
                    gen_sequence(seq.data)
                    --indent_level
                end
                print("\n")
                print_indent()
                print(")")
            end
        end
    end
    function run(os, stx)
        target = os
        syntax = stx
        target.println("(* Generated by CovScript EBNF Grammar Exporter *)")
        var time_str = to_string(runtime.local_time())
        while time_str.size > 0 && (time_str[time_str.size - 1] == '\n' || time_str[time_str.size - 1] == '\r')
            time_str.cut(1)
        end
        target.println("(* Date: " + time_str + " *)")
        target.println("")
        foreach it in stx
            if it.first == "ignore"
                target.println("(* ignore rule (whitespace/comments, not part of grammar) *)")
            end
            target.print(sanitize_name(it.first) + " =")
            target.println("")
            ++indent_level
            print_indent()
            gen_sequence(it.second)
            --indent_level
            target.println(" ;")
            target.println("")
        end
    end
end
