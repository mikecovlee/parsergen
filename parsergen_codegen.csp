# Covariant Script ParserGen Code Generator v2.0.0
# Generates standalone, optimized native recursive-descent parser packages.
#
# Usage:
#   import parsergen_codegen, your_grammar_module
#   (new parsergen_codegen.code_generator).generate("json_parser", your_gram, lex_regexes, "./json_parser.csp")
#
# The generated package:
#   - Expands grammar into direct recursive-descent parse functions
#   - Pre-computes predict (boot) sets at generate time
#   - Builds AST identical to parsergen.generator output
#   - Exposes the same API as parsergen.generator
#   - User code changes: `import parsergen` -> `import json_parser`
#
