package parsergen_codegen

import parsergen, regex

function _escape_str(str)
    var result = new string
    for i = 0, i < str.size, ++i
        if str[i] == '\\'
            result += "\\\\"
        else
            if str[i] == '"'
                result += "\\\""
            else
                if str[i] == '\n'
                    result += "\\n"
                else
                    result += str[i]
                end
            end
        end
    end
    return move(result)
end

function _sanitize_name(name)
    var result = new string
    for i = 0, i < name.size, ++i
        if name[i] == '-'
            result += '_'
        else
            result += name[i]
        end
    end
    return move(result)
end

struct _boot_result
    var ds = new hash_set
    var ts = new hash_set
end

function _boot(seq)
    var result = new _boot_result
    foreach it in seq
        if it.type == parsergen.syntax_type.token
            result.ts.insert(it.data)
            break
        end
        if it.type == parsergen.syntax_type.term
            result.ds.insert(it.data)
            break
        end
        if it.type == parsergen.syntax_type.ref
            result.ds.insert("@@" + _sanitize_name(it.data))
            break
        end
        if it.type == parsergen.syntax_type.repeat || it.type == parsergen.syntax_type.opt
            var sub = _boot(it.data)
            result.ds = hash_set.merge(result.ds, sub.ds)
            result.ts = hash_set.merge(result.ts, sub.ts)
            continue
        end
        if it.type == parsergen.syntax_type.nlook
            continue
        end
        if it.type == parsergen.syntax_type.cond
            foreach cp in it.data
                var sub = _boot(cp.data)
                result.ds = hash_set.merge(result.ds, sub.ds)
                result.ts = hash_set.merge(result.ts, sub.ts)
            end
            break
        end
    end
    return move(result)
end

function _predict_expr(br)
    var parts = new array
    foreach d in br.ds
        if d.size >= 2 && d[0] == '@' && d[1] == '@'
            var name = new string
            for i = 2, i < d.size, ++i
                name += d[i]
            end
            parts.push_back("_p_" + name + "()")
        else
            parts.push_back("_tk[_cs].data == \"" + _escape_str(d) + "\"")
        end
    end
    foreach t in br.ts
        parts.push_back("_tk[_cs].type == \"" + _escape_str(t) + "\"")
    end
    if parts.empty()
        return "_cs < _tk.size"
    end
    var result = new string
    for i = 0, i < parts.size, ++i
        if i > 0
            result += " || "
        end
        result += parts[i]
    end
    return move(result)
end

function _gen(it, I, with_ignore)
    var lines = new array
    if it.type == parsergen.syntax_type.token
        var qd = "\"" + _escape_str(it.data) + "\""
        lines.push_back(I + "if _cs >= _tk.size || _tk[_cs].type != " + qd)
        if with_ignore
            lines.push_back(I + "    if !_on_ign")
            lines.push_back(I + "        _ignore()")
            lines.push_back(I + "    end")
            lines.push_back(I + "    if _cs >= _tk.size || _tk[_cs].type != " + qd)
            lines.push_back(I + "        _fail = true")
            lines.push_back(I + "    end")
        else
            lines.push_back(I + "    _fail = true")
        end
        lines.push_back(I + "end")
        lines.push_back(I + "if !_fail")
        lines.push_back(I + "    _tree.nodes.push_back(_tk[_cs])")
        lines.push_back(I + "    _cs++")
        lines.push_back(I + "end")
        return move(lines)
    end
    if it.type == parsergen.syntax_type.term
        var qd = "\"" + _escape_str(it.data) + "\""
        lines.push_back(I + "if _cs >= _tk.size || _tk[_cs].data != " + qd)
        if with_ignore
            lines.push_back(I + "    if !_on_ign")
            lines.push_back(I + "        _ignore()")
            lines.push_back(I + "    end")
            lines.push_back(I + "    if _cs >= _tk.size || _tk[_cs].data != " + qd)
            lines.push_back(I + "        _fail = true")
            lines.push_back(I + "    end")
        else
            lines.push_back(I + "    _fail = true")
        end
        lines.push_back(I + "end")
        lines.push_back(I + "if !_fail")
        lines.push_back(I + "    _tree.nodes.push_back(_tk[_cs])")
        lines.push_back(I + "    _cs++")
        lines.push_back(I + "end")
        return move(lines)
    end
    if it.type == parsergen.syntax_type.ref
        var sn = _sanitize_name(it.data)
        lines.push_back(I + "if !_parse_" + sn + "(_tree)")
        lines.push_back(I + "    _fail = true")
        lines.push_back(I + "end")
        return move(lines)
    end
    if it.type == parsergen.syntax_type.repeat
        var br = _boot(it.data)
        var pred = _predict_expr(br)
        lines.push_back(I + "loop")
        lines.push_back(I + "    if _cs >= _tk.size || !(" + pred + ")")
        lines.push_back(I + "        break")
        lines.push_back(I + "    end")
        lines.push_back(I + "    _sv3 = _cs")
        lines.push_back(I + "    var _nv = _tree.nodes.size")
        lines.push_back(I + "    _fail = false")
        var sub = _gen_seq(it.data, I + "    ", with_ignore)
        foreach ln in sub do lines.push_back(ln)
        lines.push_back(I + "    if _fail")
        lines.push_back(I + "        _cs = _sv3")
        lines.push_back(I + "        while _tree.nodes.size > _nv")
        lines.push_back(I + "            _tree.nodes.pop_back()")
        lines.push_back(I + "        end")
        lines.push_back(I + "        _fail = false")
        lines.push_back(I + "        break")
        lines.push_back(I + "    end")
        lines.push_back(I + "end")
        return move(lines)
    end
    if it.type == parsergen.syntax_type.opt
        var br = _boot(it.data)
        var pred = _predict_expr(br)
        lines.push_back(I + "if _cs < _tk.size && (" + pred + ")")
        lines.push_back(I + "    _sv3 = _cs")
        lines.push_back(I + "    var _nv = _tree.nodes.size")
        lines.push_back(I + "    _fail = false")
        var sub = _gen_seq(it.data, I + "    ", with_ignore)
        foreach ln in sub do lines.push_back(ln)
        lines.push_back(I + "    if _fail")
        lines.push_back(I + "        _cs = _sv3")
        lines.push_back(I + "        while _tree.nodes.size > _nv")
        lines.push_back(I + "            _tree.nodes.pop_back()")
        lines.push_back(I + "        end")
        lines.push_back(I + "        _fail = false")
        lines.push_back(I + "    end")
        lines.push_back(I + "end")
        return move(lines)
    end
    if it.type == parsergen.syntax_type.nlook
        var br = _boot(it.data)
        var pred = _predict_expr(br)
        lines.push_back(I + "if _cs < _tk.size && (" + pred + ")")
        lines.push_back(I + "    _sv3 = _cs")
        lines.push_back(I + "    _fail = false")
        var sub = _gen_seq(it.data, I + "    ", with_ignore)
        foreach ln in sub do lines.push_back(ln)
        lines.push_back(I + "    if !_fail")
        lines.push_back(I + "        _cs = _sv3")
        lines.push_back(I + "        _fail = true")
        lines.push_back(I + "    else")
        lines.push_back(I + "        _cs = _sv3")
        lines.push_back(I + "        _fail = false")
        lines.push_back(I + "    end")
        lines.push_back(I + "end")
        return move(lines)
    end
    if it.type == parsergen.syntax_type.cond
        lines.push_back(I + "loop")
        foreach cp in it.data
            var br = _boot(cp.data)
            var pred = _predict_expr(br)
            lines.push_back(I + "    if _cs < _tk.size && (" + pred + ")")
            lines.push_back(I + "        _sv3 = _cs")
            lines.push_back(I + "        var _nv = _tree.nodes.size")
            lines.push_back(I + "        _fail = false")
            var sub = _gen_seq(cp.data, I + "        ", with_ignore)
            foreach ln in sub do lines.push_back(ln)
            lines.push_back(I + "        if !_fail")
            lines.push_back(I + "            break")
            lines.push_back(I + "        end")
            lines.push_back(I + "        _cs = _sv3")
            lines.push_back(I + "        while _tree.nodes.size > _nv")
            lines.push_back(I + "            _tree.nodes.pop_back()")
            lines.push_back(I + "        end")
            lines.push_back(I + "    end")
        end
        lines.push_back(I + "    _fail = true")
        lines.push_back(I + "    break")
        lines.push_back(I + "end")
        return move(lines)
    end
    lines.push_back(I + "// unknown syntax type")
    return move(lines)
end

function _gen_seq(seq, I, with_ignore)
    var lines = new array
    foreach it in seq
        lines.push_back(I + "if !_fail")
        var sub = _gen(it, I + "    ", with_ignore)
        foreach ln in sub do lines.push_back(ln)
        lines.push_back(I + "end")
    end
    return move(lines)
end

function _gen_fn(rname, seq, has_ignore)
    var sn = _sanitize_name(rname)
    var lines = new array
    lines.push_back("function _parse_" + sn + "(_parent)")
    lines.push_back("    var _sv = _cs")
    lines.push_back("    var _tree = new parsergen.syntax_tree")
    lines.push_back("    _tree.root = \"" + _escape_str(rname) + "\"")
    lines.push_back("    var _sv3 = 0")
    lines.push_back("    var _fail = false")
    var sub = _gen_seq(seq, "    ", has_ignore)
    foreach ln in sub do lines.push_back(ln)
    lines.push_back("    if _fail")
    lines.push_back("        _cs = _sv")
    lines.push_back("        return false")
    lines.push_back("    end")
    lines.push_back("    _parent.nodes.push_back(_tree)")
    lines.push_back("    return true")
    lines.push_back("end")
    return move(lines)
end

function _gen_ignore_fn(ign_seq)
    var lines = new array
    lines.push_back("function _ignore()")
    lines.push_back("    if _on_ign")
    lines.push_back("        return")
    lines.push_back("    end")
    lines.push_back("    _on_ign = true")
    lines.push_back("    var _sv = _cs")
    lines.push_back("    var _fail = false")
    var sub = _gen_seq(ign_seq, "    ", false)
    foreach ln in sub do lines.push_back(ln)
    lines.push_back("    if _fail")
    lines.push_back("        _cs = _sv")
    lines.push_back("    end")
    lines.push_back("    _on_ign = false")
    lines.push_back("end")
    return move(lines)
end

function _gen_lex_code(lex_patterns)
    var lines = new array
    lines.push_back("@begin")
    lines.push_back("var _lex = {")
    var keys = new array
    foreach it in lex_patterns do keys.push_back(it.first)
    for i = 0, i < keys.size, ++i
        var key = keys[i]
        var comma = (i < keys.size - 1) ? "," : ""
        var pattern = lex_patterns.at(key)
        lines.push_back("    \"" + _escape_str(key) + "\" : regex.build(\"" + _escape_str(pattern) + "\")" + comma)
    end
    lines.push_back("}.to_hash_map()")
    lines.push_back("@end")
    return move(lines)
end

class code_generator
    var target_path = ""
    var package_name = ""
    var grammar_ext = ".*"
    var buffer = null

    function _init()
        buffer = new array
    end

    function _write(text)
        buffer.push_back(text)
    end

    function _flush()
        var os = iostream.ofstream(target_path)
        foreach line in buffer do os.println(line)
    end

    function _writeln(text)
        _write(text)
    end

    function _write_lines(lines)
        foreach ln in lines do _writeln(ln)
    end

    function generate(pkg_name, gram, lex_patterns, path)
        package_name = pkg_name
        target_path = path
        grammar_ext = gram.ext
        _init()

        var stx = gram.stx
        var has_ignore = stx.exist("ignore")
        var ign_seq = null
        if has_ignore
            ign_seq = stx.at("ignore")
        end

        _writeln("# Generated by ParserGen Native Code Generator v2.0.0")
        _writeln("# Date: " + to_string(runtime.local_time()))
        _writeln("#")
        _writeln("# Usage:")
        _writeln("#   import " + pkg_name)
        _writeln("#   var gen = new " + pkg_name + ".generator")
        _writeln("#   gen.from_string(\"test\")")
        _writeln("#   var ast = gen.ast")
        _writeln("")
        _writeln("@require: 210503")
        _writeln("package " + pkg_name)
        _writeln("")
        _writeln("import parsergen, regex")
        _writeln("")

        _writeln("# --- Lexical Rules ---")
        _write_lines(_gen_lex_code(lex_patterns))
        _writeln("")

        _writeln("# --- Parser State ---")
        _writeln("var _cs = 0")
        _writeln("var _tk = null")
        if has_ignore
            _writeln("var _on_ign = false")
        end
        _writeln("var _errors = null")
        _writeln("var _max_cs = 0")
        _writeln("")

        if has_ignore
            _writeln("# --- Ignore ---")
            _write_lines(_gen_ignore_fn(ign_seq))
            _writeln("")
        end

        _writeln("# --- Predict ---")
        foreach it in stx
            if it.first == "ignore"
                continue
            end
            var br = _boot(it.second)
            var pred = _predict_expr(br)
            _writeln("function _p_" + _sanitize_name(it.first) + "()")
            if pred == "_cs < _tk.size"
                _writeln("    return _cs < _tk.size")
            else
                _writeln("    if _cs >= _tk.size")
                _writeln("        return false")
                _writeln("    end")
                _writeln("    if !(" + pred + ")")
                if has_ignore
                    _writeln("        if !_on_ign")
                    _writeln("            _ignore()")
                    _writeln("        end")
                    _writeln("        if _cs >= _tk.size")
                    _writeln("            return false")
                    _writeln("        end")
                    _writeln("        return " + pred)
                else
                    _writeln("        return false")
                end
                _writeln("    end")
                _writeln("    return true")
            end
            _writeln("end")
        end
        _writeln("")

        _writeln("# --- Parse ---")
        foreach it in stx
            if it.first == "ignore"
                continue
            end
            _writeln("")
            _write_lines(_gen_fn(it.first, it.second, has_ignore))
        end
        _writeln("")

        _writeln("# --- Generator ---")
        _writeln("class generator")
        _writeln("    var ast = null")
        _writeln("    var code_buff = null")
        _writeln("    var file_path = \"<FILE>\"")
        _writeln("    var errors = null")
        _writeln("    var stop_on_error = true")
        _writeln("    var show_prompt = true")
        _writeln("")

        _writeln("    function from_string(text)")
        _writeln("        errors = new array")
        _writeln("        _errors = new array")
        _writeln("        _max_cs = 0")
        _writeln("        code_buff = text.split({'\\n'})")
        _writeln("        code_buff.push_back(\"\")")
        _writeln("        foreach line in code_buff")
        _writeln("            for i = 0, i < line.size, ++i")
        _writeln("                if line[i] == '\\t'")
        _writeln("                    line.assign(i, ' ')")
        _writeln("                end")
        _writeln("            end")
        _writeln("        end")
        _writeln("")
        _writeln("        var lexer = new parsergen.lexer_type")
        _writeln("        var token_buff = lexer.run(_lex, text)")
        _writeln("")
        _writeln("        if !lexer.error_log.empty()")
        _writeln("            foreach it in lexer.error_log do errors.push_back(it)")
        _writeln("            if stop_on_error")
        _writeln("                return false")
        _writeln("            end")
        _writeln("        end")
        _writeln("")
        _writeln("        _cs = 0")
        _writeln("        _tk = token_buff")
        if has_ignore
            _writeln("        _on_ign = false")
        end
        _writeln("")
        _writeln("        var _dummy = new parsergen.syntax_tree")
        _writeln("        if _parse_begin(_dummy) && _cs == _tk.size")
        _writeln("            ast = _dummy.nodes[0]")
        _writeln("            return true")
        _writeln("        else")
        _writeln("            var err_set = new hash_set")
        _writeln("            foreach it in _errors")
        _writeln("                if it.cursor >= _max_cs && !err_set.exist(it.text)")
        _writeln("                    err_set.insert(it.text)")
        _writeln("                    errors.push_back(it)")
        _writeln("                end")
        _writeln("            end")
        _writeln("            return false")
        _writeln("        end")
        _writeln("    end")
        _writeln("")

        _writeln("    function from_file(path)")
        _writeln("        var ifs = iostream.ifstream(path)")
        _writeln("        if !ifs.good()")
        _writeln("            return false")
        _writeln("        end")
        _writeln("        file_path = path")
        _writeln("        var reg = regex.build(\"" + _escape_str(grammar_ext) + "\")")
        _writeln("        if reg.match(path).empty()")
        _writeln("            return false")
        _writeln("        end")
        _writeln("        var full_text = new string")
        _writeln("        var lines = new array")
        _writeln("        parsergen.read_stream(ifs, lines)")
        _writeln("        foreach line in lines do full_text += line + \"\\n\"")
        _writeln("        code_buff = lines")
        _writeln("        code_buff.push_back(\"\")")
        _writeln("        foreach line in code_buff")
        _writeln("            for i = 0, i < line.size, ++i")
        _writeln("                if line[i] == '\\t'")
        _writeln("                    line.assign(i, ' ')")
        _writeln("                end")
        _writeln("            end")
        _writeln("        end")
        _writeln("        return this.from_string(full_text)")
        _writeln("    end")
        _writeln("")

        _writeln("    function get_errors()")
        _writeln("        return errors")
        _writeln("    end")
        _writeln("")

        _writeln("    function print_errors()")
        _writeln("        errors.sort([](lhs, rhs)->lhs.pos[1] < rhs.pos[1])")
        _writeln("        foreach it in errors")
        _writeln("            system.out.print(\"File \\\"\" + file_path + \"\\\", line \" + (it.pos[1] + 1) + \": \")")
        _writeln("            system.out.println(it.text)")
        _writeln("            if it.pos[1] < code_buff.size - 1")
        _writeln("                system.out.println(\"> \" + code_buff[it.pos[1]])")
        _writeln("            end")
        _writeln("            system.out.println(\"\")")
        _writeln("        end")
        _writeln("    end")
        _writeln("end")
        _flush()
    end
end
